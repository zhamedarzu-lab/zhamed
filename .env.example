# Postgres connection string. Required.
DATABASE_URL=postgresql://user:password@localhost:5432/tracker

# Where journal photos go: "replit" for Object Storage, "local" for ./uploads.
# Defaults to replit when running on Replit, local everywhere else.
STORAGE_DRIVER=local

# Only needed if you have more than one Replit bucket and want a specific one.
# REPLIT_BUCKET_ID=

# The server serves API and client on one port.
PORT=5000
