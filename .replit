run = "npm run dev"
entrypoint = "server/index.ts"
modules = ["nodejs-20", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run build && npm start"]
build = ["sh", "-c", "npm run build"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[env]
NODE_ENV = "development"
